Options -Indexes
RewriteEngine On
RewriteRule (^|/)\. - [F,END]
RewriteRule ^(?:server|data|node_modules|scripts|site|ops|cloudinary-media)(?:/|$) - [F,END]
RewriteRule ^(?:package(?:-lock)?\.json|render\.yaml|README\.md|media-map\.json)$ - [F,END]
RewriteCond %{REQUEST_FILENAME} !gateway\.cgi$
RewriteRule ^ gateway.cgi [END]
